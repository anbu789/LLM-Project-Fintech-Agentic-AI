# ==============================================================================
# FinTech Agent — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your actual environment-specific values.
# NEVER commit .env to version control.
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development

# ------------------------------------------------------------------------------
# MongoDB Configuration
# ------------------------------------------------------------------------------
# Base connection URI
MONGO_URI=mongodb://localhost:27017/

# Database Names
MONGO_BANKING_DB=fintech_agent_db
MONGO_METADATA_DB=agent_metadata_db

# MongoDB Server-Side Authentication Controls
MONGO_AUTH_ENABLED=false
ALLOW_UNAUTHENTICATED_DEV=true
MONGO_AUTH_SOURCE=

# Dedicated Read-Only Banking Database Credentials
# Used exclusively by the query execution path to ensure zero write permissions
MONGO_READONLY_USERNAME=fintech_reader
MONGO_READONLY_PASSWORD=your_secure_readonly_password_here

# Application Metadata Database Credentials (readWrite on agent_metadata_db only)
MONGO_METADATA_USERNAME=agent_metadata_writer
MONGO_METADATA_PASSWORD=your_secure_metadata_password_here

# ------------------------------------------------------------------------------
# LLM Provider Configuration (Placeholders for Phase 2+)
# ------------------------------------------------------------------------------
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-20241022
LLM_API_KEY=your_llm_api_key_here

# ------------------------------------------------------------------------------
# ChromaDB & Schema Vector Store Configuration (Phase 3)
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSION=384
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=fintech_schema_catalog
RETRIEVAL_TOP_K=5

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=your_jwt_secret_key_minimum_32_chars_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# Query Execution & Safety Limits
# ------------------------------------------------------------------------------
MAX_RETRY_ATTEMPTS=3
REQUEST_TIMEOUT_SECONDS=30
QUERY_TIMEOUT_MS=15000
RESULT_DOC_LIMIT=1000
DRY_RUN_RESULT_LIMIT=10
MAX_PIPELINE_STAGES=20
MAX_PIPELINE_DEPTH=10

# ------------------------------------------------------------------------------
# Scheduler Configuration (APScheduler)
# ------------------------------------------------------------------------------
SCHEDULER_TIMEZONE=Asia/Kolkata
SCHEDULER_RECONCILE_INTERVAL_SECONDS=30
SCHEDULER_MAX_INSTANCES=1
JOB_MAX_CONSECUTIVE_FAILURES=3

# ------------------------------------------------------------------------------
# Notification & Delivery (Optional)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASS=your_smtp_password_here

# ------------------------------------------------------------------------------
# API & Rate Limits
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
USER_RATE_LIMIT=60
USER_LLM_BUDGET=100000
