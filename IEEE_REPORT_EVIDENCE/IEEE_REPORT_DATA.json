  "agent_architecture": {
    "orchestration_framework": "LangGraph (v1.2.20)",
    "state_contract": "AgentState (TypedDict, 30+ fields)",
    "total_workflow_nodes": 9,
    "llm_nodes_count": 2,
    "deterministic_nodes_count": 7,
    "nodes": [
      {"name": "input_guardrail", "type": "deterministic", "responsibility": "Regex safety filtering of length, prompt injection, and destructive commands"},
      {"name": "intent_router", "type": "llm_or_mock", "responsibility": "Classify user intent into 5 discrete RequestMode categories"},
      {"name": "schema_retriever", "type": "deterministic", "responsibility": "Vector search over ChromaDB schema catalog with glossary expansion"},
      {"name": "query_synthesizer", "type": "llm_or_mock", "responsibility": "Synthesize candidate MQL aggregation pipeline conforming to retrieved schema"},
      {"name": "mql_policy_validator", "type": "deterministic", "responsibility": "AST policy traversal: enforces collections, read-only stages, limits, and fields"},
      {"name": "query_executor", "type": "deterministic_gated", "responsibility": "Execute validated aggregation with 15s timeout and fail-closed live gate"},
      {"name": "result_verifier", "type": "deterministic", "responsibility": "Classify outcomes, sanitize BSON types, and coordinate bounded transient retry"},
      {"name": "schedule_planner", "type": "deterministic", "responsibility": "Parse recurrence grammar, validate IANA timezone, and project next 3 runs"},
      {"name": "response_composer", "type": "deterministic_or_llm", "responsibility": "Assemble plain-language user explanation, metrics badge, and MQL code box"}
    ],
    "routing_edges": {
      "after_guardrail": "allowed -> intent_router | rejected -> END",
      "after_intent": "QUERY_ONLY/QUERY_AND_SCHEDULE/SCHEDULE_ONLY -> schema_retriever | OUT_OF_SCOPE/CLARIFICATION -> response_composer",
      "after_validator": "VALID -> query_executor | INVALID/UNSUPPORTED -> response_composer",
      "after_verifier": "RETRYABLE_ERROR (retry <= max) -> query_executor | SCHEDULE -> schedule_planner | DEFAULT -> response_composer"
    }
  },
