# ==============================================================================
# FinTech Agent — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your actual environment-specific values.
# NEVER commit .env to version control.
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development

# ------------------------------------------------------------------------------
# MongoDB Configuration
# ------------------------------------------------------------------------------
# Base connection URI
MONGO_URI=mongodb://localhost:27017/

# Database Names
MONGO_BANKING_DB=fintech_agent_db
MONGO_METADATA_DB=agent_metadata_db

# MongoDB Server-Side Authentication Controls
MONGO_AUTH_ENABLED=false
ALLOW_UNAUTHENTICATED_DEV=true
MONGO_AUTH_SOURCE=

# Dedicated Read-Only Banking Database Credentials
# Used exclusively by the query execution path to ensure zero write permissions
MONGO_READONLY_USERNAME=fintech_reader
MONGO_READONLY_PASSWORD=your_secure_readonly_password_here

# Application Metadata Database Credentials (readWrite on agent_metadata_db only)
MONGO_METADATA_USERNAME=agent_metadata_writer
MONGO_METADATA_PASSWORD=your_secure_metadata_password_here

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# ------------------------------------------------------------------------------
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=your_primary_llm_api_key_here
LLM_API_BASE_URL=
LLM_TIMEOUT_SECONDS=30

# Provider-Specific API Keys (Isolated Credentials)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_google_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Resilient Multi-Provider Fallback (Gemini -> Groq -> Local Ollama)
LLM_FALLBACK_ENABLED=true
LLM_FALLBACK_ORDER=gemini,groq,ollama
LLM_PROVIDER_HEALTH_CHECK_ENABLED=true

# Groq Configuration
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Local LLM / Ollama Configuration
LOCAL_LLM_ENABLED=false
LOCAL_LLM_PROVIDER=ollama
LOCAL_LLM_MODEL=hf.co/mradermacher/K2-Horizon-3.7B-i1-GGUF:Q3_K_M
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=ollama

# Reasoning Effort Configuration
INTENT_ROUTER_REASONING_EFFORT=low
QUERY_SYNTHESIZER_REASONING_EFFORT=low

# Feature Gates (Sandboxed Execution & Scheduling)
PHASE6_LIVE_EXECUTION_ENABLED=false
PHASE7_SCHEDULER_ENABLED=false
PHASE7_LIVE_REGISTRATION_ENABLED=false

# ------------------------------------------------------------------------------
# ChromaDB & Schema Vector Store Configuration (Phase 3)
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSION=384
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=fintech_schema_catalog_cosine
RETRIEVAL_TOP_K=5

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=your_jwt_secret_key_minimum_32_chars_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# Query Execution & Safety Limits
# ------------------------------------------------------------------------------
MAX_RETRY_ATTEMPTS=3
REQUEST_TIMEOUT_SECONDS=30
QUERY_TIMEOUT_MS=15000
RESULT_DOC_LIMIT=1000
DRY_RUN_RESULT_LIMIT=10
MAX_PIPELINE_STAGES=20
MAX_PIPELINE_DEPTH=10

# ------------------------------------------------------------------------------
# Scheduler Configuration (APScheduler)
# ------------------------------------------------------------------------------
SCHEDULER_TIMEZONE=Asia/Kolkata
SCHEDULER_RECONCILE_INTERVAL_SECONDS=30
SCHEDULER_MAX_INSTANCES=1
JOB_MAX_CONSECUTIVE_FAILURES=3

# ------------------------------------------------------------------------------
# Notification & Delivery (Optional)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASS=your_smtp_password_here
ALERT_RECIPIENT_EMAIL=admin@example.com

# ------------------------------------------------------------------------------
# API & Rate Limits
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
USER_RATE_LIMIT=60
USER_LLM_BUDGET=100000
MAX_REQUEST_BODY_BYTES=1048576
MAX_MESSAGE_LENGTH=2000
MAX_CONVERSATION_HISTORY_TURNS=10
