{
  "database": "fintech_agent_db",
  "description": "Synthetic fintech/banking database for an AI agent that converts natural-language questions into MongoDB aggregation pipelines.",
  "currency": "INR (Indian Rupee)",
  "schema_version": "2",
  "notes": [
    "All IDs are strings (e.g. CUST000001, ACC000001). Never use MongoDB _id for joins — always use the domain ID fields.",
    "Use $lookup with localField/foreignField (not the pipeline form) for simple joins.",
    "Date fields are stored as BSON Date objects. Use $dateToString, $month, $year etc. for date-based grouping.",
    "All amounts are numbers (float/int), never strings.",
    "Categorical fields use the exact allowed_values listed here — never guess casing. All 'status'-style fields are lowercase across every collection for consistency."
  ],
  "data_integrity_rules": [
    "cards.customer_id must equal the customer_id of the account referenced by cards.account_id (never independently assigned).",
    "branches.manager_id must reference an employee whose employees.branch_id equals that same branch_id.",
    "transactions.customer_id (denormalised) must always equal the customer_id of the account referenced by transactions.account_id.",
    "fraud_alerts.customer_id must be derived from fraud_alerts.transaction_id → transactions.account_id → accounts.customer_id, never independently assigned.",
    "transaction_mode = 'RTGS' implies amount >= 200000; enforced at generation time.",
    "loans.status = 'closed' implies outstanding_amount = 0 and next_due_date = null.",
    "loans.status = 'defaulted' implies outstanding_amount > 0 and next_due_date is in the past.",
    "loans.status = 'active' implies outstanding_amount > 0 and next_due_date is in the future.",
    "kyc_documents.verification_status != 'verified' implies verified_by = null and verification_date = null.",
    "support_tickets.status not in ('resolved', 'closed') implies resolved_date = null, resolution_notes = null, and satisfaction_rating = null.",
    "investments.investment_type = 'stocks' implies maturity_date = null (stocks do not mature); all other investment_types require a non-null maturity_date."
  ],
  "relationships": [
    { "from": "employees.branch_id",               "to": "branches.branch_id",         "type": "many-to-one", "note": "Each employee belongs to one branch" },
    { "from": "branches.manager_id",               "to": "employees.employee_id",       "type": "many-to-one", "note": "Manager must work at this same branch — see data_integrity_rules" },
    { "from": "customers.relationship_manager_id", "to": "employees.employee_id",       "type": "many-to-one" },
    { "from": "accounts.customer_id",              "to": "customers.customer_id",       "type": "many-to-one", "note": "One customer can have multiple accounts" },
    { "from": "accounts.branch_id",                "to": "branches.branch_id",          "type": "many-to-one" },
    { "from": "accounts.account_manager_id",       "to": "employees.employee_id",       "type": "many-to-one" },
    { "from": "transactions.account_id",           "to": "accounts.account_id",         "type": "many-to-one" },
    { "from": "transactions.customer_id",          "to": "customers.customer_id",       "type": "many-to-one", "note": "Denormalised — enforced equal to accounts.customer_id for this account" },
    { "from": "transactions.merchant_id",          "to": "merchants.merchant_id",       "type": "many-to-one", "note": "Null for salary/cash/internal transfers" },
    { "from": "cards.customer_id",                 "to": "customers.customer_id",       "type": "many-to-one", "note": "Must match the customer of cards.account_id — see data_integrity_rules" },
    { "from": "cards.account_id",                  "to": "accounts.account_id",         "type": "many-to-one" },
    { "from": "loans.customer_id",                 "to": "customers.customer_id",       "type": "many-to-one" },
    { "from": "loans.sanctioning_branch_id",       "to": "branches.branch_id",          "type": "many-to-one" },
    { "from": "loans.loan_officer_id",             "to": "employees.employee_id",       "type": "many-to-one" },
    { "from": "kyc_documents.customer_id",         "to": "customers.customer_id",       "type": "many-to-one" },
    { "from": "kyc_documents.verified_by",         "to": "employees.employee_id",       "type": "many-to-one", "note": "Null if not yet verified" },
    { "from": "support_tickets.customer_id",       "to": "customers.customer_id",       "type": "many-to-one" },
    { "from": "support_tickets.assigned_agent_id", "to": "employees.employee_id",       "type": "many-to-one" },
    { "from": "fraud_alerts.transaction_id",       "to": "transactions.transaction_id", "type": "many-to-one" },
    { "from": "fraud_alerts.customer_id",          "to": "customers.customer_id",       "type": "many-to-one", "note": "Derived from transaction→account→customer chain — see data_integrity_rules" },
    { "from": "fraud_alerts.reviewed_by",          "to": "employees.employee_id",       "type": "many-to-one", "note": "Null if not yet reviewed" },
    { "from": "investments.customer_id",           "to": "customers.customer_id",       "type": "many-to-one" }
  ],
  "collections": {
    "branches": {
      "description": "Physical bank branches. Generated first — all other collections that reference a branch use branch_id from this collection.",
      "primary_key": "branch_id",
      "fields": {
        "branch_id":           { "type": "string",  "description": "Unique branch identifier, e.g. BR00001" },
        "branch_name":         { "type": "string" },
        "ifsc_code":           { "type": "string",  "description": "Synthetic IFSC, e.g. FNTK0000001" },
        "address":             { "type": "string" },
        "city":                { "type": "string" },
        "state":               { "type": "string" },
        "pincode":             { "type": "string",  "description": "6-digit postal code" },
        "region":              { "type": "string",  "allowed_values": ["North", "South", "East", "West", "Central"] },
        "branch_type":         { "type": "string",  "allowed_values": ["urban", "rural", "metro", "semi-urban"] },
        "manager_id":          { "type": "string",  "references": "employees.employee_id", "note": "Integrity rule: manager must be an employee whose branch_id equals this branch_id" },
        "contact_number":      { "type": "string" },
        "opening_date":        { "type": "date" },
        "working_hours":       { "type": "string",  "description": "e.g. '9:00 AM - 5:00 PM'" },
        "has_atm":             { "type": "boolean" },
        "has_locker_facility": { "type": "boolean" },
        "employee_count":      { "type": "integer" },
        "status":              { "type": "string",  "allowed_values": ["active", "inactive", "closed"], "note": "v2: lowercase; expanded to include inactive and closed for edge-case testing" },
        "created_at":          { "type": "date" }
      }
    },
    "employees": {
      "description": "Bank staff. Referenced by branches (manager), customers (relationship_manager), accounts (account_manager), loans (loan_officer), kyc_documents (verified_by), support_tickets (assigned_agent), and fraud_alerts (reviewed_by).",
      "primary_key": "employee_id",
      "fields": {
        "employee_id":        { "type": "string",  "description": "e.g. EMP000001" },
        "first_name":         { "type": "string" },
        "last_name":          { "type": "string" },
        "designation":        { "type": "string",  "allowed_values": ["Clerk", "Officer", "Manager", "Senior Manager", "Executive"], "note": "role_level field removed in v2 — use designation for seniority" },
        "department":         { "type": "string",  "allowed_values": ["Retail Banking", "Loans", "Customer Service", "Fraud & Risk", "Operations", "IT"] },
        "branch_id":          { "type": "string",  "references": "branches.branch_id" },
        "email":              { "type": "string" },
        "phone":              { "type": "string" },
        "date_of_joining":    { "type": "date" },
        "salary":             { "type": "number",  "description": "Annual salary in INR" },
        "manager_id":         { "type": "string",  "references": "employees.employee_id", "note": "Null for top-level executives" },
        "employment_status":  { "type": "string",  "allowed_values": ["active", "on_leave", "resigned"] },
        "performance_rating": { "type": "number",  "description": "2.0 to 5.0" },
        "created_at":         { "type": "date" }
      }
    },
    "merchants": {
      "description": "Registered merchants where customers make purchases. Referenced by transactions.merchant_id (nullable — null for cash/NEFT/internal transfers).",
      "primary_key": "merchant_id",
      "fields": {
        "merchant_id":               { "type": "string",  "description": "e.g. MER000001" },
        "merchant_name":             { "type": "string" },
        "category":                  { "type": "string",  "allowed_values": ["groceries", "electronics", "fuel", "dining", "travel", "utilities", "healthcare", "entertainment"] },
        "mcc_code":                  { "type": "string",  "description": "Merchant Category Code" },
        "city":                      { "type": "string" },
        "state":                     { "type": "string" },
        "registration_date":         { "type": "date" },
        "is_verified":               { "type": "boolean" },
        "average_transaction_value": { "type": "number",  "description": "INR" },
        "total_transactions":        { "type": "integer" },
        "created_at":                { "type": "date" }
      }
    },
    "customers": {
      "description": "Bank customers (individual and corporate). Central entity — referenced by every other domain collection.",
      "primary_key": "customer_id",
      "fields": {
        "customer_id":             { "type": "string",  "description": "e.g. CUST000001" },
        "first_name":              { "type": "string" },
        "last_name":               { "type": "string" },
        "dob":                     { "type": "date" },
        "age":                     { "type": "integer" },
        "gender":                  { "type": "string",  "allowed_values": ["Male", "Female", "Other"] },
        "email":                   { "type": "string" },
        "phone":                   { "type": "string" },
        "address_line1":           { "type": "string" },
        "city":                    { "type": "string" },
        "state":                   { "type": "string" },
        "pincode":                 { "type": "string" },
        "country":                 { "type": "string",  "description": "Always 'India'" },
        "pan_number":              { "type": "string",  "description": "Synthetic masked PAN, e.g. ABCDE1234F" },
        "aadhar_masked":           { "type": "string",  "description": "Always masked: XXXX-XXXX-{last4}" },
        "occupation":              { "type": "string",  "allowed_values": ["Salaried", "Self-Employed", "Business Owner", "Student", "Retired", "Homemaker"] },
        "annual_income":           { "type": "number",  "description": "Annual income in INR" },
        "marital_status":          { "type": "string",  "allowed_values": ["Single", "Married", "Divorced", "Widowed"] },
        "nationality":             { "type": "string",  "description": "Always 'Indian'" },
        "kyc_status":              { "type": "string",  "allowed_values": ["verified", "pending", "rejected"] },
        "risk_category":           { "type": "string",  "allowed_values": ["low", "medium", "high"] },
        "account_opening_date":    { "type": "date" },
        "preferred_language":      { "type": "string",  "allowed_values": ["English", "Tamil", "Hindi", "Telugu"] },
        "customer_segment":        { "type": "string",  "allowed_values": ["Regular", "Premium", "HNI", "Student", "Senior"] },
        "customer_type":           { "type": "string",  "allowed_values": ["individual", "corporate"] },
        "credit_score":            { "type": "integer", "description": "CIBIL-style score", "minimum": 300, "maximum": 900 },
        "relationship_manager_id": { "type": "string",  "references": "employees.employee_id" },
        "is_active":               { "type": "boolean", "description": "true iff status = 'active'" },
        "status":                  { "type": "string",  "allowed_values": ["active", "inactive", "blocked", "closed"], "note": "v2: lowercase — matches every other collection" },
        "created_at":              { "type": "date" },
        "updated_at":              { "type": "date" }
      }
    },
    "accounts": {
      "description": "Bank accounts. A customer can have zero, one, or multiple accounts. Referenced by transactions and cards.",
      "primary_key": "account_id",
      "fields": {
        "account_id":           { "type": "string",  "description": "e.g. ACC000001" },
        "customer_id":          { "type": "string",  "references": "customers.customer_id" },
        "account_number":       { "type": "string",  "description": "Synthetic, e.g. ACCTNO0000000001" },
        "account_type":         { "type": "string",  "allowed_values": ["savings", "current", "salary", "fixed_deposit", "recurring_deposit"] },
        "branch_id":            { "type": "string",  "references": "branches.branch_id" },
        "ifsc_code":            { "type": "string" },
        "currency":             { "type": "string",  "allowed_values": ["INR"] },
        "balance":              { "type": "number",  "description": "Current balance in INR" },
        "available_balance":    { "type": "number" },
        "opening_date":         { "type": "date" },
        "status":               { "type": "string",  "allowed_values": ["active", "dormant", "blocked", "closed"] },
        "interest_rate":        { "type": "number",  "description": "Annual %" },
        "minimum_balance":      { "type": "number",  "description": "Minimum balance requirement in INR" },
        "overdraft_limit":      { "type": "number",  "description": "0 if no overdraft facility" },
        "nominee_name":         { "type": "string" },
        "joint_holder":         { "type": "string",  "description": "Null if no joint holder" },
        "account_manager_id":   { "type": "string",  "references": "employees.employee_id" },
        "last_transaction_date":{ "type": "date" },
        "created_at":           { "type": "date" },
        "updated_at":           { "type": "date" }
      }
    },
    "transactions": {
      "description": "Financial transactions. Largest collection (~10k). customer_id is denormalised and must always equal accounts[account_id].customer_id.",
      "primary_key": "transaction_id",
      "fields": {
        "transaction_id":    { "type": "string",  "description": "e.g. TXN000000001" },
        "account_id":        { "type": "string",  "references": "accounts.account_id" },
        "customer_id":       { "type": "string",  "references": "customers.customer_id", "note": "Denormalised — enforced equal to accounts[account_id].customer_id by generator" },
        "transaction_type":  { "type": "string",  "allowed_values": ["debit", "credit"] },
        "amount":            { "type": "number",  "description": "INR" },
        "currency":          { "type": "string",  "allowed_values": ["INR"] },
        "transaction_date":  { "type": "date" },
        "transaction_mode":  { "type": "string",  "allowed_values": ["UPI", "NEFT", "RTGS", "IMPS", "cash", "cheque", "card"], "note": "RTGS enforced >= 200000 by generator" },
        "merchant_id":       { "type": "string",  "references": "merchants.merchant_id", "note": "Null for salary/NEFT/cash/internal transfers" },
        "description":       { "type": "string" },
        "balance_after":     { "type": "number",  "description": "Account balance after this transaction" },
        "status":            { "type": "string",  "allowed_values": ["success", "failed", "pending", "reversed"] },
        "reference_number":  { "type": "string" },
        "counterparty_account": { "type": "string" },
        "counterparty_name": { "type": "string" },
        "channel":           { "type": "string",  "allowed_values": ["mobile", "web", "atm", "branch", "pos"] },
        "location":          { "type": "string" },
        "ip_address":        { "type": "string" },
        "device_id":         { "type": "string" },
        "is_flagged":        { "type": "boolean", "description": "True for ~2% of transactions; fraud_alerts reference these" },
        "category":          { "type": "string",  "allowed_values": ["groceries", "salary", "rent", "utilities", "transfer", "shopping", "dining", "fuel", "investment", "healthcare", "education", "travel", "entertainment"] },
        "created_at":        { "type": "date" }
      }
    },
    "cards": {
      "description": "Debit and credit cards. customer_id MUST match accounts[account_id].customer_id (enforced by generator). Expired cards have status='expired'.",
      "primary_key": "card_id",
      "fields": {
        "card_id":            { "type": "string",  "description": "e.g. CARD000001" },
        "customer_id":        { "type": "string",  "references": "customers.customer_id", "note": "Derived from account_id — must equal accounts[account_id].customer_id" },
        "account_id":         { "type": "string",  "references": "accounts.account_id" },
        "card_number_masked": { "type": "string",  "description": "Always XXXX-XXXX-XXXX-{last4}" },
        "card_type":          { "type": "string",  "allowed_values": ["debit", "credit"] },
        "card_network":       { "type": "string",  "allowed_values": ["visa", "mastercard", "rupay"] },
        "issue_date":         { "type": "date" },
        "expiry_date":        { "type": "date",    "note": "If expiry_date < today, status = 'expired'" },
        "credit_limit":       { "type": "number",  "description": "0 for debit cards" },
        "available_credit":   { "type": "number",  "description": "0 for debit cards" },
        "status":             { "type": "string",  "allowed_values": ["active", "blocked", "expired"] },
        "is_contactless":     { "type": "boolean" },
        "pin_set":            { "type": "boolean" },
        "billing_cycle_day":  { "type": "integer", "description": "Day of month 1-28" },
        "last_used_date":     { "type": "date" },
        "reward_points":      { "type": "integer" },
        "created_at":         { "type": "date" }
      }
    },
    "loans": {
      "description": "Loan records. Null-field rules: closed → outstanding=0, next_due=null; defaulted → next_due in past; active → next_due in future.",
      "primary_key": "loan_id",
      "fields": {
        "loan_id":                  { "type": "string",  "description": "e.g. LOAN000001" },
        "customer_id":              { "type": "string",  "references": "customers.customer_id" },
        "loan_type":                { "type": "string",  "allowed_values": ["home", "personal", "auto", "education", "gold", "business"] },
        "principal_amount":         { "type": "number",  "description": "Original loan amount in INR" },
        "interest_rate":            { "type": "number",  "description": "Annual %" },
        "tenure_months":            { "type": "integer" },
        "emi_amount":               { "type": "number",  "description": "Monthly EMI in INR" },
        "disbursement_date":        { "type": "date" },
        "status":                   { "type": "string",  "allowed_values": ["active", "closed", "defaulted"] },
        "outstanding_amount":       { "type": "number",  "description": "Remaining balance. 0 when status=closed; >0 when active or defaulted" },
        "next_due_date":            { "type": "date",    "note": "Null when status=closed. Past date when defaulted. Future date when active." },
        "collateral_type":          { "type": "string",  "allowed_values": ["property", "vehicle", "gold", "fd", "none"] },
        "co_applicant":             { "type": "string",  "description": "Null if no co-applicant" },
        "sanctioning_branch_id":    { "type": "string",  "references": "branches.branch_id" },
        "loan_officer_id":          { "type": "string",  "references": "employees.employee_id" },
        "credit_score_at_approval": { "type": "integer" },
        "purpose":                  { "type": "string" },
        "prepayment_flag":          { "type": "boolean" },
        "created_at":               { "type": "date" }
      }
    },
    "kyc_documents": {
      "description": "KYC identity documents. verification_status != 'verified' → verified_by and verification_date must both be null.",
      "primary_key": "kyc_id",
      "fields": {
        "kyc_id":                  { "type": "string",  "description": "e.g. KYC000001" },
        "customer_id":             { "type": "string",  "references": "customers.customer_id" },
        "document_type":           { "type": "string",  "allowed_values": ["passport", "aadhar", "pan", "voter_id", "driving_license"] },
        "document_number_masked":  { "type": "string",  "description": "Always synthetic/masked" },
        "issue_date":              { "type": "date" },
        "expiry_date":             { "type": "date" },
        "verification_status":     { "type": "string",  "allowed_values": ["verified", "pending", "rejected"] },
        "verified_by":             { "type": "string",  "references": "employees.employee_id", "note": "Null unless verification_status='verified'" },
        "verification_date":       { "type": "date",    "note": "Null unless verification_status='verified'" },
        "document_url":            { "type": "string" },
        "created_at":              { "type": "date" }
      }
    },
    "support_tickets": {
      "description": "Customer support tickets. status not in ('resolved','closed') → resolved_date, resolution_notes, satisfaction_rating are all null.",
      "primary_key": "ticket_id",
      "fields": {
        "ticket_id":          { "type": "string",  "description": "e.g. TKT000001" },
        "customer_id":        { "type": "string",  "references": "customers.customer_id" },
        "category":           { "type": "string",  "allowed_values": ["complaint", "query", "request", "fraud_report", "account_issue", "card_issue", "loan_issue"] },
        "subject":            { "type": "string" },
        "description":        { "type": "string" },
        "priority":           { "type": "string",  "allowed_values": ["low", "medium", "high", "critical"] },
        "status":             { "type": "string",  "allowed_values": ["open", "in_progress", "resolved", "closed"] },
        "assigned_agent_id":  { "type": "string",  "references": "employees.employee_id" },
        "created_date":       { "type": "date" },
        "resolved_date":      { "type": "date",    "note": "Null unless status in ('resolved','closed')" },
        "resolution_notes":   { "type": "string",  "note": "Null unless status in ('resolved','closed')" },
        "channel":            { "type": "string",  "allowed_values": ["phone", "email", "chat", "branch"] },
        "satisfaction_rating":{ "type": "integer", "description": "1 to 5", "minimum": 1, "maximum": 5, "note": "Null unless status in ('resolved','closed')" },
        "created_at":         { "type": "date" }
      }
    },
    "fraud_alerts": {
      "description": "Fraud alerts derived from flagged transactions. customer_id is always derived from transaction→account→customer chain — never independently assigned.",
      "primary_key": "alert_id",
      "fields": {
        "alert_id":       { "type": "string",  "description": "e.g. ALT000001" },
        "transaction_id": { "type": "string",  "references": "transactions.transaction_id" },
        "customer_id":    { "type": "string",  "references": "customers.customer_id", "note": "Derived: fraud_alerts.transaction_id → transactions.account_id → accounts.customer_id" },
        "alert_type":     { "type": "string",  "allowed_values": ["unusual_amount", "velocity", "geo_mismatch", "device_change", "blacklisted_merchant"] },
        "risk_score":     { "type": "number",  "description": "0 (safe) to 100 (high risk)" },
        "status":         { "type": "string",  "allowed_values": ["open", "investigating", "resolved", "false_positive"] },
        "detected_at":    { "type": "date" },
        "reviewed_by":    { "type": "string",  "references": "employees.employee_id", "note": "Null unless status is 'investigating' or 'resolved'" },
        "review_notes":   { "type": "string",  "note": "Null unless reviewed" },
        "action_taken":   { "type": "string",  "allowed_values": ["none", "account_frozen", "customer_contacted", "transaction_reversed"] },
        "created_at":     { "type": "date" }
      }
    },
    "investments": {
      "description": "Customer investment portfolio. investment_type='stocks' → maturity_date=null. All other types require a maturity_date.",
      "primary_key": "investment_id",
      "fields": {
        "investment_id":     { "type": "string",  "description": "e.g. INV000001" },
        "customer_id":       { "type": "string",  "references": "customers.customer_id" },
        "investment_type":   { "type": "string",  "allowed_values": ["mutual_fund", "fixed_deposit", "stocks", "bonds", "ppf"] },
        "amount_invested":   { "type": "number",  "description": "INR" },
        "current_value":     { "type": "number",  "description": "Current market value; may be less than amount_invested" },
        "purchase_date":     { "type": "date" },
        "maturity_date":     { "type": "date",    "note": "Null when investment_type='stocks'; required for all other types" },
        "status":            { "type": "string",  "allowed_values": ["active", "matured", "redeemed"] },
        "returns_percentage":{ "type": "number",  "description": "Can be negative for loss-making investments" },
        "risk_level":        { "type": "string",  "allowed_values": ["low", "medium", "high"] },
        "fund_manager":      { "type": "string" },
        "created_at":        { "type": "date" }
      }
    }
  }
}
